{
  "name": "clean",
  "label": "Clean",
  "extends": null,
  "description": "Heavy grotesque caps, no outline, soft two-layer shadow. The whole phrase sits dim and fills to white as it is spoken; one warm accent marks the hook word. A dark pill appears only when the background is bright.",
  "caption": {
    "font": "ArchivoBlack-Regular.ttf",
    "size": 78,
    "tracking": 0,
    "case": "upper",
    "strip_punct": ".,",
    "color": "#FFFFFF",
    "unspoken_alpha": 0.70,
    "accent": "#FFD84D",
    "accent_reveal": "on_spoken",
    "emphasis": {"sources": ["hook", "manual"], "per_page": 1, "font": null, "size_mult": 1.0},
    "reveal": "fill",
    "anim": {"in_ms": 100, "rise_px": 8, "pop": false},
    "shadow": [{"blur": 14, "alpha": 0.45, "dy": 3}, {"blur": 3, "alpha": 0.7, "dy": 2}],
    "outline": {"px": 0, "color": "#000000"},
    "backing": {"mode": "auto", "color": "#0B0B0DD9", "radius": 22, "pad": [28, 14], "min_contrast": 3.0, "max_edges": 0.15},
    "layout": {"max_words": 4, "max_chars": 16, "max_lines": 2, "max_width": 780, "line_gap": 0.98,
               "pause_break": 0.45, "comma_min_words": 2, "min_page": 0.8, "y": 1250},
    "lead_ms": 60
  },
  "hook_card": {"font": "ArchivoBlack-Regular.ttf", "max_size": 120, "min_size": 56, "max_width": 920,
                "min_ratio": 1.3,
                "color": "#FFFFFF", "accent": "#FFD84D", "case": "upper", "line_gap": 1.0,
                "fade_out_ms": 260, "backing": {"mode": "auto"}},
  "landscape": {"caption": {"size": 54, "layout": {"y": 930, "max_width": 1500, "max_lines": 2}},
                "hook_card": {"max_size": 76, "min_size": 44, "max_width": 1200}},
  "letterbox": {"y_center": 820, "blur": 28, "dim": 0.35},
  "motion": {"punch_in": 1.12, "min_gap": 3.5, "max_upscale": 3.0},
  "cover": {"headline_font": "ArchivoBlack-Regular.ttf", "size_range": [96, 168], "max_lines": 4,
            "color": "#FFFFFF", "accent": "#FFD84D", "band": [240, 1680], "margin": 70,
            "tint": "#0B0B0D", "tint_from": 0.42, "tint_alpha": 0.86, "rule": false,
            "lockup": [], "lockup_font": "Montserrat[wght].ttf:SemiBold", "lockup_size": 34},
  "safezone": "organic"
}
